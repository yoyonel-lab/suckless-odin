@(private="file")
perlin_fade :: #force_inline proc(t: f32) -> f32 {
	return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

@(private="file")
perlin_grad :: #force_inline proc(h: u8, x, y, z: f32) -> f32 {
	h_mask := h & 15
	u := x if h_mask < 8 else y
	v := y if h_mask < 4 else (x if h_mask == 12 || h_mask == 14 else z)
	res_u := u if (h_mask & 1) == 0 else -u
	res_v := v if (h_mask & 2) == 0 else -v
	return res_u + res_v
}

@(private="file")
perlin3d_periodic :: proc(x, y, z: f32, period: i32) -> f32 {
	xi := i32(math.floor(x)) % period
	yi := i32(math.floor(y)) % period
	zi := i32(math.floor(z)) % period
	if xi < 0 do xi += period
	if yi < 0 do yi += period
	if zi < 0 do zi += period

	xf := x - math.floor(x)
	yf := y - math.floor(y)
	zf := z - math.floor(z)

	u := perlin_fade(xf)
	v := perlin_fade(yf)
	w := perlin_fade(zf)

	xi1 := (xi + 1) % period
	yi1 := (yi + 1) % period
	zi1 := (zi + 1) % period

	p := &PERLIN_PERM
	aaa := p[p[p[xi] + u8(yi)] + u8(zi)]
	aba := p[p[p[xi] + u8(yi1)] + u8(zi)]
	aab := p[p[p[xi] + u8(yi)] + u8(zi1)]
	abb := p[p[p[xi] + u8(yi1)] + u8(zi1)]
	baa := p[p[p[xi1] + u8(yi)] + u8(zi)]
	bba := p[p[p[xi1] + u8(yi1)] + u8(zi)]
	bab := p[p[p[xi1] + u8(yi)] + u8(zi1)]
	bbb := p[p[p[xi1] + u8(yi1)] + u8(zi1)]

	x1 := math.lerp(perlin_grad(aaa, xf, yf, zf), perlin_grad(baa, xf - 1.0, yf, zf), u)
	x2 := math.lerp(perlin_grad(aba, xf, yf - 1.0, zf), perlin_grad(bba, xf - 1.0, yf - 1.0, zf), u)
	y1 := math.lerp(x1, x2, v)

	x3 := math.lerp(perlin_grad(aab, xf, yf, zf - 1.0), perlin_grad(bab, xf - 1.0, yf, zf - 1.0), u)
	x4 := math.lerp(perlin_grad(abb, xf, yf - 1.0, zf - 1.0), perlin_grad(bbb, xf - 1.0, yf - 1.0, zf - 1.0), u)
	y2 := math.lerp(x3, x4, v)

	return math.lerp(y1, y2, w)
}

@(private="file")
worley3d_periodic :: proc(x, y, z: f32) -> f32 {
	period :: WORLEY_GRID_PERIOD
	cx := i32(math.floor(x)) % period
	cy := i32(math.floor(y)) % period
	cz := i32(math.floor(z)) % period
	if cx < 0 do cx += period
	if cy < 0 do cy += period
	if cz < 0 do cz += period

	fx := x - math.floor(x)
	fy := y - math.floor(y)
	fz := z - math.floor(z)

	min_dist_sq: f32 = 100.0

	for dz in -1..=1 {
		ncz := (cz + i32(dz)) % period
		if ncz < 0 do ncz += period
		for dy in -1..=1 {
			ncy := (cy + i32(dy)) % period
			if ncy < 0 do ncy += period
			for dx in -1..=1 {
				ncx := (cx + i32(dx)) % period
				if ncx < 0 do ncx += period

				cell_idx := (ncz * period + ncy) * period + ncx
				jitter := WORLEY_OFFSETS[cell_idx]

				vx := f32(dx) + jitter[0] - fx
				vy := f32(dy) + jitter[1] - fy
				vz := f32(dz) + jitter[2] - fz
				d2 := vx * vx + vy * vy + vz * vz
				if d2 < min_dist_sq {
					min_dist_sq = d2
				}
			}
		}
	}

	dist := math.sqrt(min_dist_sq)
	// Invert so cell centers are bright, and cube power curve for distinct particle points
	w := 1.0 - clamp(dist * 1.25, 0.0, 1.0)
	return w * w * w
}

// Generates a 64x64x64 periodic 3D texture:
// Channel R: 3-octave Perlin FBM (continuous smoke / macro fog)
// Channel G: Worley cellular noise (discrete dust particles)
create_dust_noise_texture_3d :: proc() -> u32 {
	zone := tracy.zone_begin(&srcloc_create_dust_noise)
	defer tracy.zone_end(zone)

	size :: DUST_NOISE_3D_SIZE
	// 2 channels: R (Perlin) + G (Worley) = 512 KB
	voxels := make([]u8, size * size * size * 2, context.temp_allocator)

	idx := 0
	for z in 0..<size {
		fz := f32(z) / f32(size)
		for y in 0..<size {
			fy := f32(y) / f32(size)
			for x in 0..<size {
				fx := f32(x) / f32(size)

				// Channel R: 3 octaves Perlin FBM (periods 4, 8, 16)
				oct0 := perlin3d_periodic(fx * 4.0,  fy * 4.0,  fz * 4.0,  4)  * 0.50
				oct1 := perlin3d_periodic(fx * 8.0,  fy * 8.0,  fz * 8.0,  8)  * 0.30
				oct2 := perlin3d_periodic(fx * 16.0, fy * 16.0, fz * 16.0, 16) * 0.20
				perlin_val := clamp((oct0 + oct1 + oct2 + 0.6) * 0.8, 0.0, 1.0)

				// Channel G: Periodic Worley cellular noise (period 8)
				worley_val := clamp(worley3d_periodic(fx * 8.0, fy * 8.0, fz * 8.0) * 1.5, 0.0, 1.0)

				voxels[idx * 2 + 0] = u8(perlin_val * 255.0)
				voxels[idx * 2 + 1] = u8(worley_val * 255.0)
				idx += 1
			}
		}
	}

	tex_id: u32
	gl.GenTextures(1, &tex_id)
	gl.BindTexture(gl.TEXTURE_3D, tex_id)

	gl.TexImage3D(
		gl.TEXTURE_3D, 0, gl.RG8,
		size, size, size, 0,
		gl.RG, gl.UNSIGNED_BYTE, raw_data(voxels),
	)

	gl.TexParameteri(gl.TEXTURE_3D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
	gl.TexParameteri(gl.TEXTURE_3D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)
	gl.TexParameteri(gl.TEXTURE_3D, gl.TEXTURE_WRAP_S, gl.REPEAT)
	gl.TexParameteri(gl.TEXTURE_3D, gl.TEXTURE_WRAP_T, gl.REPEAT)
	gl.TexParameteri(gl.TEXTURE_3D, gl.TEXTURE_WRAP_R, gl.REPEAT)

	gl.BindTexture(gl.TEXTURE_3D, 0)
	return tex_id
}
