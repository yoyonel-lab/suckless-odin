# valgrind.supp — Valgrind memory leak suppressions for suckless-odin.
# Suppresses third-party system libraries, OpenGL drivers, and D-Bus/GameMode leaks.

{
   Suppress_Odin_Runtime_Conditional_Zero_Cond
   Memcheck:Cond
   fun:*conditional_mem_zero*
}

{
   Suppress_Odin_Runtime_Heap_Allocator_Cond
   Memcheck:Cond
   fun:*heap_allocator_proc*
}

{
   Suppress_Odin_Runtime_Conditional_Zero_Value8
   Memcheck:Value8
   fun:*conditional_mem_zero*
}

{
   Suppress_Odin_Runtime_Heap_Allocator_Value8
   Memcheck:Value8
   fun:*heap_allocator_proc*
}

{
   Suppress_Unresolved_System_Leaks_Calloc
   Memcheck:Leak
   fun:calloc
   obj:*
}

{
   Suppress_Unresolved_System_Leaks_Malloc
   Memcheck:Leak
   fun:malloc
   obj:*
}

{
   Suppress_Unresolved_System_Leaks_Realloc
   Memcheck:Leak
   fun:realloc
   obj:*
}

{
   Suppress_DBus_GameMode_Leaks
   Memcheck:Leak
   ...
   obj:*/libdbus-*.so*
}

{
   Suppress_GameMode_Internal_Allocations
   Memcheck:Leak
   ...
   fun:*try_gamemode*
}

{
   Suppress_Mesa_Intel_Driver_Leaks
   Memcheck:Leak
   ...
   obj:*/dri/*.so
}

{
   Suppress_GL_Loader_Driver_Leaks
   Memcheck:Leak
   ...
   obj:*/libGL*.so*
}

{
   Suppress_X11_Windowing_System_Leaks
   Memcheck:Leak
   ...
   obj:*/libX11*.so*
}

{
   Suppress_XCB_Connection_Leaks
   Memcheck:Leak
   ...
   obj:*/libxcb*.so*
}

{
   Suppress_GLFW_Library_Leaks
   Memcheck:Leak
   ...
   obj:*/libglfw*.so*
}

{
   Suppress_Gallium_Driver_Cond
   Memcheck:Cond
   obj:*/libgallium*.so*
}

{
   Suppress_Gallium_Driver_Value8
   Memcheck:Value8
   obj:*/libgallium*.so*
}

{
   Suppress_Gallium_Driver_Value4
   Memcheck:Value4
   obj:*/libgallium*.so*
}

{
   Suppress_Gallium_Driver_Leak
   Memcheck:Leak
   ...
   obj:*/libgallium*.so*
}

{
   Suppress_LLVM_JIT_Cond
   Memcheck:Cond
   obj:*/libLLVM*.so*
}

{
   Suppress_LLVM_JIT_Value8
   Memcheck:Value8
   obj:*/libLLVM*.so*
}

{
   Suppress_LLVM_JIT_Value4
   Memcheck:Value4
   obj:*/libLLVM*.so*
}

{
   Suppress_LLVM_JIT_Leak
   Memcheck:Leak
   ...
   obj:*/libLLVM*.so*
}

{
   Suppress_Mesa_Driver_Cond
   Memcheck:Cond
   obj:*/dri/*.so*
}

{
   Suppress_GL_Loader_Driver_Cond
   Memcheck:Cond
   obj:*/libGL*.so*
}

