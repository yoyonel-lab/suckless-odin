#!/usr/bin/env bash
# Pre-push hook: full validation before pushing to remote
# Install: just pre-commit-install
set -euo pipefail

# Extra linker flags (must match Justfile)
EXTRA_LINKER_FLAGS="-L/home/linuxbrew/.linuxbrew/lib -Wl,-rpath,/home/linuxbrew/.linuxbrew/lib -lX11"

echo "🔍 pre-push: lint..."
odin check src/ -vet -strict-style -warnings-as-errors

echo "🔨 pre-push: build (debug)..."
mkdir -p build/debug
odin build src/ -out:build/debug/suckless-odin -debug -extra-linker-flags:"${EXTRA_LINKER_FLAGS}"

echo "🧪 pre-push: unit tests..."
odin test tests/

echo "🧪 pre-push: CLI tests..."
odin test src/

echo "🧪 pre-push: shader CPU tests..."
odin test src/rendering/shader/

echo "🧪 pre-push: GL tests (headless)..."
if command -v xvfb-run &>/dev/null; then
    xvfb-run -a -s "-screen 0 1024x768x24" \
        odin test tests/gl/ -define:ODIN_TEST_THREADS=1 -extra-linker-flags:"${EXTRA_LINKER_FLAGS}"
else
    echo "⚠️  xvfb-run not available, running GL tests with current display..."
    odin test tests/gl/ -define:ODIN_TEST_THREADS=1 -extra-linker-flags:"${EXTRA_LINKER_FLAGS}"
fi

echo "✅ pre-push: all checks passed — safe to push"
